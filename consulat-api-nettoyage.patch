-
-            $membre = Membre::where('activation_token', $request->token)->first();
-
-            if (!$membre) {
-                return response()->json([
-                    'success' => false,
-                    'message' => 'Lien d\'activation invalide'
-                ], 404);
-            }
-
-            if (!$membre->activation_token_expire_at || $membre->activation_token_expire_at->isPast()) {
-                return response()->json([
-                    'success' => false,
