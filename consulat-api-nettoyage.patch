-
-    /**
-     * Exporter les demandes en CSV
-     */
-    public function exporter(Request $request)
-    {
-        try {
-            $query = Adhesion::query();
-
-            if ($request->has('statut') && $request->statut !== 'tous') {
-                $query->where('statut', $request->statut);
