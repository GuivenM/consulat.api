APP_NAME="Consulat Congo-Bénin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL du frontend (liens des emails) et origines CORS autorisées
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Entité utilisée par défaut (V1 : une seule)
CONSULAT_DEFAULT_ENTITY_SLUG=congo-benin

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# En local, "log" écrit les emails dans storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Consulat Honoraire du Congo au Bénin"
# Reçoit les alertes "nouveau message de contact"
MAIL_ADMIN_ADDRESS=

# Facultatif : publication des actualités sur la page Facebook
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Réservé au futur paiement en ligne
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
